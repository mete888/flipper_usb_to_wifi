App(
    appid="fib_sdk_example",
    name="Bridge SDK Client",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="fib_sdk_example_main",
    stack_size=4096,
    sources=[
        "vendor/internet_bridge/examples/flipper_bridge_client/example_app.c",
        "vendor/internet_bridge/*.c",
        "vendor/internet_bridge/sdk/flipper/*.c",
    ],
    fap_category="Tools",
    fap_version="1.0",
    fap_author="mete888",
    fap_description="Public bridge SDK HTTPS client",
)
